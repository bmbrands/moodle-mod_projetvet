{{!
    @template mod_projetvet/form/element_number

    Number input form element.

    Context variables required for this template:
    * name - The element name
    * id - The element id
    * value - The current value
    * frozen - Whether the element is frozen
    * min - Minimum value (optional)
    * max - Maximum value (optional)
    * step - Step increment (optional)
    * extraattributes - Any additional HTML attributes

    Example context (json):
    {
        "name": "field_123",
        "id": "id_field_123",
        "value": "42",
        "frozen": false,
        "min": "0",
        "max": "100",
        "step": "1",
        "extraattributes": ""
    }
}}
<input type="number"
       class="form-control"
       name="{{name}}"
       id="{{id}}"
       {{#frozen}}disabled{{/frozen}}
       {{#value}}value="{{value}}"{{/value}}
       {{#min}}min="{{min}}"{{/min}}
       {{#max}}max="{{max}}"{{/max}}
       {{#step}}step="{{step}}"{{/step}}
       {{! Use a plugin-specific attribute name instead of data-action because core_form/modalform's
           disableButtons() selector "[data-action]" would otherwise match this input and set
           disabled="true" right before form.serialize(), causing the field to be dropped from the
           submitted data and triggering "You must supply a value here." on every submit. }}
       {{#action}}data-projetvet-action="{{action}}"{{/action}}
       {{#string}}data-projetvet-string="{{string}}"{{/string}}
       {{{extraattributes}}}>
{{#action}}<div class="mt-1 text-muted" id="{{id}}_suggestion"></div>{{/action}}
