{{!
    @template mod_projetvet/view_page

    View page for student entries.

    Example context (json):
    {
        "isteacher": false,
        "showbacklink": false,
        "backurl": "",
        "studentname": "",
        "cmid": 1,
        "projetvetid": 1,
        "studentid": 123,
        "activitiesheading": "Activities",
        "showactivitiesbutton": true,
        "activitiesbuttonlabel": "Add activity",
        "showactionbuttons": true,
        "archivewaitingmessage": "Your archive is waiting for your tutor",
        "showarchivebutton": true,
        "archivebuttonlabel": "Archive projects already validated with the previous system",
        "archiveformsetidnumber": "archive",
        "activitiesreport": "<div>Report HTML</div>",
        "facetofaceheading": "Face-to-face sessions",
        "showfacetofacebutton": true,
        "facetofacebuttonlabel": "Add session",
        "facetofacereport": "<div>Report HTML</div>"
    }
}}
<h3>{{activitiesheading}}</h3>

<div class="alert alert-secondary small" role="alert">
 {{{activitiesinfobox}}}
</div>

{{#archivewaitingmessage}}
<div class="alert alert-info" role="status">
    {{{archivewaitingmessage}}}
</div>
{{/archivewaitingmessage}}

{{#showactionbuttons}}
<div class="mb-3 d-flex flex-wrap gap-2">
    {{#showactivitiesbutton}}
    <button class="btn btn-primary"
            data-action="activity-entry-form"
            data-cmid="{{cmid}}"
            data-projetvetid="{{projetvetid}}"
            data-studentid="{{studentid}}"
            data-formsetidnumber="activities">
        {{activitiesbuttonlabel}}
    </button>
    {{/showactivitiesbutton}}
    {{#showarchivebutton}}
    <button class="btn btn-secondary"
            data-action="archive-entry-form"
            data-cmid="{{cmid}}"
            data-projetvetid="{{projetvetid}}"
            data-studentid="{{studentid}}"
            data-formsetidnumber="{{archiveformsetidnumber}}">
        {{archivebuttonlabel}}
    </button>
    {{/showarchivebutton}}
</div>
{{/showactionbuttons}}

{{{activitiesreport}}}

<h3 class="mt-3">{{facetofaceheading}}</h3>

<div class="alert alert-secondary small" role="alert">
 {{{facetofaceinfobox}}}
</div>

{{#showfacetofacebutton}}
<div class="mb-3">
    <button class="btn btn-primary"
            data-action="activity-entry-form"
            data-cmid="{{cmid}}"
            data-projetvetid="{{projetvetid}}"
            data-studentid="{{studentid}}"
            data-formsetidnumber="facetoface">
        {{facetofacebuttonlabel}}
    </button>
</div>
{{/showfacetofacebutton}}

{{{facetofacereport}}}
